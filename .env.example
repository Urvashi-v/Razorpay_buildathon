# =============================================================================
# RTO Sentinel - example environment
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.
# Every variable below is read through src/rto_sentinel/settings.py - nothing in
# this codebase reads os.environ directly.
# =============================================================================

# --- application -------------------------------------------------------------
RTO_ENV=development                 # development | test | production
RTO_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
RTO_API_HOST=127.0.0.1
RTO_API_PORT=8000
# Comma-separated origins allowed to call the API from a browser.
# --- API authentication ------------------------------------------------------
# Comma-separated `name:secret` pairs. The name is not a credential - it
# identifies the caller in rate-limit accounting so a leaked key can be revoked
# without guessing who was using it.
#
# Empty is allowed in development and test only. With RTO_ENV=production the
# process REFUSES TO START without keys, because an API that silently runs open
# serves every order to anyone who can reach the port.
#
#   python -c "import secrets; print('sk_live_' + secrets.token_urlsafe(32))"
#
# Entries are name:secret:scope, and THE SCOPE DEFAULTS TO read WHEN OMITTED.
# Only a write key may POST a decision or an override; everything else is a read.
# Least privilege by default - a key added in a hurry cannot mutate the audit
# log, and granting that power means deliberately typing :write.
#
#   RTO_API_KEYS=console:sk_live_abc...,ops:sk_live_def...:write
RTO_API_KEYS=

# Requests per minute per key. 0 disables.
RTO_RATE_LIMIT_PER_MINUTE=120

# Where the counters live: memory (default) or database.
#
# memory is correct for ONE uvicorn worker and wrong for several - each keeps its
# own buckets, so N workers permit N times the rate. database shares one counter
# across every worker at the cost of one round trip per request.
#
# RUNNING MORE THAN ONE WORKER? SET THIS TO database.
RTO_RATE_LIMIT_BACKEND=memory

RTO_CORS_ORIGINS=http://localhost:5173

# --- database ----------------------------------------------------------------
# PostgreSQL is the target for development and production.
# The docker-compose service below matches these defaults; change the password
# before exposing the database anywhere beyond localhost.
POSTGRES_USER=rto
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=rto_sentinel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL wins over the individual parts above when it is set.
# Tests override this with an ephemeral SQLite file; see tests/conftest.py.
# Use 127.0.0.1 rather than localhost for a container published on IPv4 only.
# `localhost` resolves to ::1 first on Windows and modern Linux; a Docker port
# published as 127.0.0.1:5442->5432 is not listening there, so every connect
# pays the IPv6 timeout before falling back.
RTO_DATABASE_URL=postgresql+psycopg://rto:change-me-locally@127.0.0.1:5432/rto_sentinel

# --- configuration files ------------------------------------------------------
# Paths are resolved relative to the repository root when not absolute.
RTO_CONFIG_DIR=config
RTO_ARTIFACT_DIR=artifacts

# --- ML pipeline --------------------------------------------------------------
# Global seed for the synthetic generator, splits and model training.
# Changing this changes every reported number; it is recorded in run metadata.
RTO_RANDOM_SEED=20260827
# Model artefact the API loads at startup. Empty => the scoring endpoint reports
# itself unavailable rather than inventing a score.
RTO_ACTIVE_MODEL_PATH=

# --- LLM / agent layer (OPTIONAL) --------------------------------------------
# EXTERNAL SERVICE: Anthropic Claude API (https://api.anthropic.com).
# Used only for the four downstream language jobs (reason-code phrasing,
# confirmation-message drafting, merchant digest prose, address-repair
# suggestions). It never produces a risk score or a decision.
#
# Leave ANTHROPIC_API_KEY empty to run the whole system without the LLM: agent
# endpoints then return an explicit "unavailable" response. They do NOT fall
# back to canned text pretending to be model output.
ANTHROPIC_API_KEY=
RTO_LLM_MODEL=claude-sonnet-5
RTO_LLM_MAX_TOKENS=1024
RTO_LLM_TIMEOUT_SECONDS=20
# Hard off-switch that overrides the presence of a key.
RTO_AGENTS_ENABLED=false

# --- frontend (console) -------------------------------------------------------
# Vite only exposes variables prefixed with VITE_ to browser code.
# Never put a secret here: anything with this prefix ships to the client bundle.
VITE_API_BASE_URL=http://localhost:8000
